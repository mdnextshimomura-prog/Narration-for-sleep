# Anthropic API キーをここに設定してください。
# このファイルを .env.local という名前でコピーして使います。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ログイン保護（任意）。
# APP_PASSWORD を設定すると、アプリを開く際にログインが求められます。
# Vercel に公開する場合は、ここに自分だけが知るパスワードを設定してください。
# 未設定の場合は保護なし（ローカル開発向け）。
# APP_USER は省略すると "admin" になります。
APP_USER=admin
APP_PASSWORD=
